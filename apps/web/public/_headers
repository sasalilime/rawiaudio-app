# En-têtes HTTP des fichiers statiques sur Cloudflare (lu au déploiement, jamais servi).

# Le service worker doit être revérifié à chaque visite : sinon une nouvelle version de l'appli tarde à arriver.
/sw.js
  Cache-Control: no-cache

# Les fichiers de Vite changent de nom à chaque version : on peut les garder un an.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
