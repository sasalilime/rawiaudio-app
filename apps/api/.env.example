# Copier en .env (jamais commité) : cp .env.example .env
# Valeurs entre guillemets : le fichier est aussi chargé par le shell (set -a; . ./.env).

# Mot de passe du Postgres de développement, lu par compose.yaml.
# Il est recopié dans des URLs : lettres, chiffres et - . _ ~ uniquement.
# Le changer ici impose de le changer aussi dans les deux URLs ci-dessous.
POSTGRES_PASSWORD="dev-a-changer"

# Lus par l'API lancée avec go run.
PORT="8080"
# Adresse d'écoute. Vide : toutes les interfaces. Sur le VPS : 127.0.0.1 (systemd), Caddy relaie.
HOST=""
DATABASE_URL="postgres://rawi:dev-a-changer@localhost:5432/rawi?sslmode=disable"

# Cloudflare R2 (ADR-0003), lus par l'API. Les deux clés viennent d'un token R2
# « Object Read only » limité au bucket, créé dans le tableau de bord Cloudflare.
R2_ENDPOINT="https://<account-id>.eu.r2.cloudflarestorage.com"
R2_BUCKET="rawi-audio"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Origine de la PWA autorisée en CORS. Vide en dev : Vite relaie /api sur la même origine.
CORS_ALLOWED_ORIGIN=""

# Adresse publique des illustrations (ADR-0009). Vide : https://media.rawiaudio.com.
IMAGES_BASE_URL=""

# Connexion par e-mail (ADR-0012). Clé du HMAC des codes : openssl rand -hex 32.
AUTH_SECRET=""
# Le lien de l'e-mail mène à la PWA de dev.
APP_URL="http://localhost:5180"
# Mailpit (docker compose up -d mailpit) : les e-mails restent sur http://127.0.0.1:8026, rien ne part.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1026"
SMTP_USERNAME=""
SMTP_PASSWORD=""
MAIL_FROM="Rawi Audio <connexion@rawiaudio.com>"
# Facultatif : e-mails de connexion par 24 heures, 90 par défaut.
MAIL_DAILY_CAP=""

# Lu par les tests d'intégration (go test) : sans elle, ils sont sautés.
# Chaque test travaille dans un schéma jetable, la base de dev peut donc servir.
TEST_DATABASE_URL="postgres://rawi:dev-a-changer@localhost:5432/rawi?sslmode=disable"
