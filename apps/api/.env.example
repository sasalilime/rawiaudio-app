# Copier en .env (jamais commité) : cp .env.example .env
# Valeurs entre guillemets : le fichier est aussi chargé par le shell (set -a; . ./.env).

# Mot de passe du Postgres de développement, lu par compose.yaml.
POSTGRES_PASSWORD="dev-a-changer"

# Lus par l'API lancée avec go run.
PORT="8080"
DATABASE_URL="postgres://rawi:dev-a-changer@localhost:5432/rawi?sslmode=disable"
