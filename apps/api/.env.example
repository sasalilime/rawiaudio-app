# Copier en .env (jamais commité) : cp .env.example .env
# Valeurs entre guillemets : le fichier est aussi chargé par le shell (set -a; . ./.env).

# Mot de passe du Postgres de développement, lu par compose.yaml.
# Il est recopié dans des URLs : lettres, chiffres et - . _ ~ uniquement.
# Le changer ici impose de le changer aussi dans les deux URLs ci-dessous.
POSTGRES_PASSWORD="dev-a-changer"

# Lus par l'API lancée avec go run.
PORT="8080"
DATABASE_URL="postgres://rawi:dev-a-changer@localhost:5432/rawi?sslmode=disable"

# Lu par les tests d'intégration (go test) : sans elle, ils sont sautés.
# Chaque test travaille dans un schéma jetable, la base de dev peut donc servir.
TEST_DATABASE_URL="postgres://rawi:dev-a-changer@localhost:5432/rawi?sslmode=disable"
