# Secrets de l'API sur le VPS : /etc/rawi.env, propriétaire root, chmod 600 (ops/runbooks/installer-sur-le-vps.md).
# Lu par systemd au démarrage de rawi-api (EnvironmentFile). Jamais commité, jamais copié ailleurs.
# Pas de DATABASE_URL ici : l'API se connecte à Postgres par le socket local, sans mot de passe (rawi-api.service).

# Cloudflare R2 (ADR-0003) : token « Object Read only » de production, limité au bucket rawi-audio.
# Distinct du token de dev.
R2_ENDPOINT="https://<account-id>.eu.r2.cloudflarestorage.com"
R2_BUCKET="rawi-audio"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Seule origine autorisée à lire l'API depuis un navigateur : la PWA.
CORS_ALLOWED_ORIGIN="https://app.rawiaudio.com"

# Connexion par e-mail (ADR-0012).
# Clé du HMAC des codes, propre au VPS : openssl rand -hex 32. La changer invalide les codes en cours.
AUTH_SECRET=""
# Le lien de l'e-mail mène à la PWA.
APP_URL="https://app.rawiaudio.com"
# Resend en SMTP, TLS dès la connexion. Le mot de passe est une clé API Resend propre à l'API,
# en « Sending access » limitée au domaine rawiaudio.com.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USERNAME="resend"
SMTP_PASSWORD=""
MAIL_FROM="Rawi Audio <connexion@rawiaudio.com>"
# E-mails de connexion par 24 heures. Resend gratuit : 100 par jour ; 90 garde une marge.
MAIL_DAILY_CAP="90"
