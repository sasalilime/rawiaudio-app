# API de Rawi Audio sur le VPS (ADR-0011). Installé par `make deploy-api` dans /etc/systemd/system/.
[Unit]
Description=API de Rawi Audio (Go + Postgres)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
# Jamais root : l'utilisateur système rawi, que Postgres reconnaît sans mot de passe (authentification « peer »).
User=rawi
Group=rawi
WorkingDirectory=/var/www/rawi
ExecStart=/var/www/rawi/rawi-api
# Au démarrage, l'API applique les migrations : si Postgres n'est pas encore prêt, elle s'arrête et repart 5 s plus tard.
Restart=always
RestartSec=5
# Plafond mémoire (l'API en utilise quelques dizaines de Mo) : si elle déraille, elle seule redémarre.
MemoryMax=512M
Environment=HOST=127.0.0.1
Environment=PORT=8100
# Socket local de Postgres, sans mot de passe : rien de secret ici.
Environment=DATABASE_URL=postgres://rawi@/rawi?host=/var/run/postgresql
# Token R2 et origine CORS : fichier lisible par root seul (chmod 600), jamais dans git.
EnvironmentFile=/etc/rawi.env

# Durcissement : l'API ne lit que son binaire et n'écrit nulle part.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictNamespaces=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Les sauvegardes appartiennent aussi à rawi : l'API n'a pas à les lire.
InaccessiblePaths=-/var/backups/rawi
# Réseau : l'API n'écoute que sur son port (un autre site ne peut pas le prendre pendant un redémarrage, et
# l'API ne peut pas prendre le leur). Sorties : seulement les e-mails de connexion vers Resend (ADR-0012),
# dont les adresses changent, d'où pas de liste d'IP autorisées. La signature R2 reste locale, Postgres
# passe par le socket.
SocketBindAllow=tcp:8100
SocketBindDeny=any
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
