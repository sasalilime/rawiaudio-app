# Secrets de production, sur le VPS seulement : cp .env.example .env, puis chmod 600 .env.
# Jamais commité (voir .gitignore), jamais copié ailleurs.

# Mot de passe de Postgres, recopié dans une URL : lettres, chiffres et - . _ ~ uniquement.
# Lu seulement à la création du volume : le changer ensuite ne change rien.
POSTGRES_PASSWORD=""

# Cloudflare R2 (ADR-0003) : token « Object Read only » de production, limité au bucket rawi-audio.
# Distinct du token de dev.
R2_ENDPOINT="https://<account-id>.eu.r2.cloudflarestorage.com"
R2_BUCKET="rawi-audio"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Seule origine autorisée à lire l'API depuis un navigateur : la PWA.
CORS_ALLOWED_ORIGIN="https://app.rawiaudio.com"
